{
  "name": "get-next-version",
  "description": "Bump versions with the help of semantic versioning and pull requests labels",
  "version": "3.0.0",
  "author": "MiguelRipoll23",
  "scripts": {
    "bundle": "npm run format:write && npm run package",
    "format:write": "npx prettier --write .",
    "format:check": "npx prettier --check .",
    "lint": "npx eslint .",
    "test": "git branch -f playground && git checkout playground && npm run package",
    "package": "npx ncc build src/index.ts -o dist --source-map --license licenses.txt"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MiguelRipoll23/get-next-version.git"
  },
  "bugs": {
    "url": "https://github.com/MiguelRipoll23/get-next-version/issues"
  },
  "keywords": [
    "bump",
    "version",
    "action"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "semver": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.1",
    "@types/semver": "^7.7.1",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vercel/ncc": "^0.38.4",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1"
  }
}
