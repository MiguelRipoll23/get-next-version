#!/bin/sh
# Auto-rebuild dist/ when src/ files change

if git diff --cached --name-only --diff-filter=ACMR | grep -q '^src/'; then
  echo "🔨 src/ files changed — rebuilding dist/..."
  npm run package || exit 1
  git add dist/index.js dist/index.js.map dist/licenses.txt dist/sourcemap-register.cjs dist/package.json 2>/dev/null
fi
